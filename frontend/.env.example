# Copie para .env.local (não versionado) e preencha.

# Desenvolvimento (npm run dev): URL da API SEM o "/api/" final.
# O Vite repassa /api/* para ela, então não é preciso CORS.
API_PROXY_TARGET=https://SEU-ID.execute-api.sa-east-1.amazonaws.com

