{
  "version": "2.0",
  "app_name": "leitor-placas",
  "environment_variables": {
    "BUCKET_NAME": "leitor-placas-c68524",
    "TRANSLATE_REGION": "us-east-1",
    "POLLY_REGION": "us-east-1",
    "LIMITE_ENVIOS_DIA": "30",
    "LIMITE_ENVIOS_MES": "300",
    "CORS_ORIGIN": "https://davifpassos.github.io",
    "FRONTEND_URL": "https://davifpassos.github.io/chalice_aws/",
    "PARAMETRO_CODIGO_ACESSO": "/leitor-placas/codigo-acesso"
  },
  "stages": {
    "dev": {
      "api_gateway_stage": "api",
      "autogen_policy": false,
      "iam_policy_file": "policy-dev.json",
      "lambda_timeout": 30,
      "lambda_functions": {
        "ao_enviar_imagem": {
          "lambda_timeout": 60,
          "lambda_memory_size": 512
        }
      }
    }
  }
}
